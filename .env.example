# 复制为 .env 后二选一填写；用法： set -a; source .env; set +a   （PowerShell 见 README）

# ── 路线 A：OpenAI 直连 ───────────────────────────────
# AZURE_OPENAI_AUTH_MODE=openai_compatible
# AZURE_OPENAI_ENDPOINT=https://api.openai.com/v1
# AZURE_OPENAI_API_KEY=

# ── 路线 B：Azure OpenAI ──────────────────────────────
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_API_KEY=
# 或免 key：AZURE_OPENAI_AUTH_MODE=azure_cli

# ── 路线 C：DeepSeek（OpenAI 兼容，最省钱；需先打 patches/deepseek-backend-adapter.patch）──
# AZURE_OPENAI_AUTH_MODE=openai_compatible
# AZURE_OPENAI_ENDPOINT=https://api.deepseek.com
# AZURE_OPENAI_API_KEY=
# 运行时：--optimizer_model deepseek-chat --target_model deepseek-chat --reasoning_effort ""

# 模型名（gpt 两路通用；DeepSeek 见路线 C；亦可用 --optimizer_model/--target_model 覆盖）
OPTIMIZER_MODEL=gpt-5.5
TARGET_MODEL=gpt-5.5

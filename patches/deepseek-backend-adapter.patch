+def _is_openai_compat_client(client: AzureOpenAI | OpenAI) -> bool:
+    """True for a plain OpenAI-compatible client (DeepSeek, vLLM/qwen, etc.).
+
+    Such endpoints expect ``max_tokens`` (not the Azure/OpenAI-new
+    ``max_completion_tokens``) and reject OpenAI-only params like
+    ``reasoning_effort``. AzureOpenAI is a subclass of OpenAI, so we exclude it.
+    """
+    return isinstance(client, OpenAI) and not isinstance(client, AzureOpenAI)
+
